# this file is commited to the code base;
# define the variables used in the app here;
# to override values locally create a .env.local file and define the variables there;
# For more information on the topic look at the readme file in section "Environment Variables"
VITE_VERSION=$npm_package_version
VITE_NAME=$npm_package_name
VITE_BUILD_VERSION=dev
VITE_BUILD_DATE=dev
VITE_BUILD_REVISION=dev
BROWSER=google-chrome
BROWSER_ARGS=http://localhost:3000
VITE_APP_ALKEMIO_DOMAIN=http://localhost:3000
# GraphQL schema source for `pnpm codegen`. Defaults to the running server;
# override in .env.local (e.g. a gitignored ./schema.graphql) to work offline.
CODEGEN_SCHEMA=http://localhost:3000/graphql

SENTRY_AUTH_TOKEN=
VITE_APP_LOG_ERRORS=true

# Unified collaboration service (memo + whiteboard) — the browser opens
# ws://<host>/collab/<documentId>?type=memo|whiteboard through the gateway
# (Traefik/Oathkeeper → collaboration-service). Replaces the legacy Socket.IO
# (whiteboard) + Hocuspocus (memo) endpoints.
VITE_APP_COLLAB_PATH=/collab

# Opt the Vite dev server back into registering the service worker.
# Required to test PUSH NOTIFICATIONS locally: PushManager hangs off
# ServiceWorkerRegistration, so without a registration `serviceWorker.ready`
# never settles and the push toggle hangs. Leave false unless testing push.
VITE_ENABLE_SERVICE_WORKER=true

# Matrix browser session: browser-facing Synapse origin (empty = not
# configured for this environment). Defaults to the local quickstart stack's
# Synapse behind Traefik; deployed environments set their own value.
VITE_APP_MATRIX_HOMESERVER_URL=http://localhost:8008
# Call-token service base URL; empty disables group calls. Set it in .env.local for local development.
VITE_APP_LIVEKIT_SERVICE_URL=

# Public Statuspage API the site-wide incident / maintenance notice reads.
# Empty = no notice, which is the local default. Each deployed environment sets
# it in its config map: one shared page for dev, test, sandbox and acceptance,
# another for production. To try it locally, set it in .env.local, e.g.
# VITE_APP_STATUSPAGE_API_URL=https://7m9028tgc2rb.statuspage.io/api/v2
VITE_APP_STATUSPAGE_API_URL=
